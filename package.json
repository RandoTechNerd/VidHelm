{
  "name": "vidhelm",
  "private": true,
  "version": "1.3.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc -b && vite build && electron-builder",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "agent": "node agent/mcp-server.mjs",
    "selftest": "node agent/selftest.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/three": "^0.185.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "description": "VidHelm — a lean desktop video editor for makers: you take the helm, your AI crews the busywork. Tag points, karaoke narration booth, cloned-voice narration, synthesized SFX, Start Recipes, and a built-in MCP server.",
  "license": "MIT",
  "author": "RandoTechNerd <randotechnerd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/RandoTechNerd/VidHelm"
  },
  "build": {
    "appId": "com.randotechnerd.vidhelm",
    "productName": "VidHelm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "ffprobe.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "homepage": "https://vidhelm.com"
}
